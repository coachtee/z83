# Copy to .env and fill in for local development. Never commit .env.

# Postgres connection used by database/migrate.mjs, database/seed.mjs and services/api
DATABASE_URL=postgresql://z83:z83@localhost:5432/z83

# services/api
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-value
SESSION_COOKIE_NAME=z83_session
# local | supabase | r2 — see docs/ARCHITECTURE.md#storage-abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-dev
WEB_ORIGIN=http://localhost:3000

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
