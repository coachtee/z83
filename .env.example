# Copy to .env and fill in for local development. Never commit .env.

# Postgres connection used by database/migrate.mjs, database/seed.mjs and services/api
DATABASE_URL=postgresql://z83:z83@localhost:5432/z83

# services/api
API_PORT=4000
JWT_SECRET=change-me-to-a-long-random-value
# Signs local-storage download URLs — set a separate long random value in
# production so a JWT_SECRET leak doesn't also forge document URLs. Falls
# back to JWT_SECRET if left unset, which is fine for local dev.
STORAGE_SIGNING_SECRET=
SESSION_COOKIE_NAME=z83_session
# local | supabase | r2 — see docs/ARCHITECTURE.md#storage-abstraction
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-dev
WEB_ORIGIN=http://localhost:3000

# Real email dispatch (POST /applications/:id/send). Leave SMTP_HOST unset
# in dev — sending then reports "not configured" instead of silently
# no-op'ing. See docs/ARCHITECTURE.md#email-preparation-and-sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Z83 <no-reply@naleli.co.za>"

# apps/web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
